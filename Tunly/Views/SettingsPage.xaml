<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Tunly.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Tunly.Controls"
    Background="Transparent">

    <Grid Padding="28,22,28,28" RowSpacing="12">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="LayoutStates">
                <VisualState x:Name="NarrowState">
                    <VisualState.Setters>
                        <Setter Target="CategoryColumn.Width" Value="0" />
                        <Setter Target="CategoryList.Visibility" Value="Collapsed" />
                        <Setter Target="CategoryCombo.Visibility" Value="Visible" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="WideState">
                    <VisualState.Setters>
                        <Setter Target="CategoryColumn.Width" Value="180" />
                        <Setter Target="CategoryList.Visibility" Value="Visible" />
                        <Setter Target="CategoryCombo.Visibility" Value="Collapsed" />
                    </VisualState.Setters>
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1150" />
                    </VisualState.StateTriggers>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Spacing="2">
                <TextBlock Text="Settings" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="Tailor the app and the tunnel to your needs." Style="{StaticResource PageSubtitleStyle}" />
            </StackPanel>

            <ComboBox
                x:Name="CategoryCombo"
                Grid.Column="1"
                Width="180"
                Visibility="Collapsed"
                VerticalAlignment="Center"
                SelectionChanged="OnCategoryComboChanged">
                <ComboBoxItem Content="Appearance" />
                <ComboBoxItem Content="Startup &amp; window" />
                <ComboBoxItem Content="Connection" />
                <ComboBoxItem Content="Core &amp; logs" />
                <ComboBoxItem Content="About" />
            </ComboBox>

            <TextBlock
                Grid.Column="2"
                Text="{Binding StatusText}"
                Style="{StaticResource CaptionStyle}"
                VerticalAlignment="Center"
                MaxWidth="240"
                TextTrimming="CharacterEllipsis" />
        </Grid>

        <!-- Body -->
        <Grid Grid.Row="1" ColumnSpacing="24" Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="CategoryColumn" Width="180" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ListView
                x:Name="CategoryList"
                SelectionMode="Single"
                ItemContainerStyle="{StaticResource CategoryListItemStyle}"
                SelectionChanged="OnCategoryListChanged"
                VerticalAlignment="Top">
                <ListViewItem>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon Glyph="&#xE790;" FontSize="14" />
                        <TextBlock Text="Appearance" />
                    </StackPanel>
                </ListViewItem>
                <ListViewItem>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon Glyph="&#xE7E8;" FontSize="14" />
                        <TextBlock Text="Startup &amp; window" />
                    </StackPanel>
                </ListViewItem>
                <ListViewItem>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon Glyph="&#xE839;" FontSize="14" />
                        <TextBlock Text="Connection" />
                    </StackPanel>
                </ListViewItem>
                <ListViewItem>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon Glyph="&#xE756;" FontSize="14" />
                        <TextBlock Text="Core &amp; logs" />
                    </StackPanel>
                </ListViewItem>
                <ListViewItem>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon Glyph="&#xE946;" FontSize="14" />
                        <TextBlock Text="About" />
                    </StackPanel>
                </ListViewItem>
            </ListView>

            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid MaxWidth="940" HorizontalAlignment="Stretch" Margin="0,0,4,24">

                    <!-- ============ Appearance ============ -->
                    <StackPanel x:Name="AppearanceSection">
                        <TextBlock Text="Appearance" Style="{StaticResource SectionTitleStyle}" Margin="2,0,0,8" />

                        <controls:SettingsCard
                            Header="App theme"
                            Description="Use the Windows setting, or force light or dark."
                            Glyph="&#xE790;">
                            <controls:SettingsCard.ActionContent>
                                <ComboBox
                                    Width="170"
                                    ItemsSource="{Binding ThemeOptions}"
                                    SelectedItem="{Binding Settings.Theme, Mode=TwoWay}" />
                            </controls:SettingsCard.ActionContent>
                        </controls:SettingsCard>

                        <controls:SettingsCard
                            Header="Window material"
                            Description="Mica applies the desktop wallpaper tint; acrylic adds translucency."
                            Glyph="&#xE81E;">
                            <controls:SettingsCard.ActionContent>
                                <ComboBox
                                    Width="170"
                                    ItemsSource="{Binding BackdropOptions}"
                                    SelectedItem="{Binding Settings.Backdrop, Mode=TwoWay}" />
                            </controls:SettingsCard.ActionContent>
                        </controls:SettingsCard>

                        <controls:SettingsCard
                            Header="Compact navigation"
                            Description="Keep the sidebar in its icon-only form, even on large windows."
                            Glyph="&#xE700;">
                            <controls:SettingsCard.ActionContent>
                                <ToggleSwitch Style="{StaticResource SettingsToggleStyle}" IsOn="{Binding Settings.CompactPane, Mode=TwoWay}" />
                            </controls:SettingsCard.ActionContent>
                        </controls:SettingsCard>
                    </StackPanel>

                    <!-- ============ Startup & window ============ -->
                    <StackPanel x:Name="GeneralSection" Visibility="Collapsed">
                        <TextBlock Text="Startup &amp; window" Style="{StaticResource SectionTitleStyle}" Margin="2,0,0,8" />

                        <controls:SettingsCard
                            Header="Auto-connect on launch"
                            Description="Connect to the last used profile when Tunly starts."
                            Glyph="&#xE768;">
                            <controls:SettingsCard.ActionContent>
                                <ToggleSwitch Style="{StaticResource SettingsToggleStyle}" IsOn="{Binding Settings.AutoConnect, Mode=TwoWay}" />
                            </controls:SettingsCard.ActionContent>
                        </controls:SettingsCard>

                        <controls:SettingsCard
                            Header="Remember window size"
                            Description="Restore the previous window size the next time the app opens."
                            Glyph="&#xE740;">
                            <controls:SettingsCard.ActionContent>
                                <ToggleSwitch Style="{StaticResource SettingsToggleStyle}" IsOn="{Binding Settings.RememberWindow, Mode=TwoWay}" />
                            </controls:SettingsCard.ActionContent>
                        </controls:SettingsCard>

                        <controls:SettingsCard
                            Header="Launch maximized"
                            Description="Open Tunly in a maximized window."
                            Glyph="&#xE922;">
                            <controls:SettingsCard.ActionContent>
                                <ToggleSwitch Style="{StaticResource SettingsToggleStyle}" IsOn="{Binding Settings.LaunchMaximized, Mode=TwoWay}" />
                            </controls:SettingsCard.ActionContent>
                        </controls:SettingsCard>

                        <controls:SettingsCard
                            Header="Always on top"
                            Description="Keep the window above other apps."
                            Glyph="&#xE718;">
                            <controls:SettingsCard.ActionContent>
                                <ToggleSwitch Style="{StaticResource SettingsToggleStyle}" IsOn="{Binding Settings.AlwaysOnTop, Mode=TwoWay}" />
                            </controls:SettingsCard.ActionContent>
                        </controls:SettingsCard>
                    </StackPanel>

                    <!-- ============ Connection ============ -->
                    <StackPanel x:Name="ConnectionSection" Visibility="Collapsed">
                        <TextBlock Text="Tunnel" Style="{StaticResource SectionTitleStyle}" Margin="2,0,0,8" />

                        <controls:SettingsCard
                            Header="TUN stack"
                            Description="Network stack used by the virtual adapter."
                            Glyph="&#xE839;">
                            <controls:SettingsCard.ActionContent>
                                <ComboBox
                                    Width="150"
                                    ItemsSource="{Binding TunStackOptions}"
                                    SelectedItem="{Binding Settings.TunStack, Mode=TwoWay}" />
                            </controls:SettingsCard.ActionContent>
                        </controls:SettingsCard>

                        <controls:SettingsCard
                            Header="Auto route"
                            Description="Add routes for the TUN interface automatically."
                            Glyph="&#xE8AB;">
                            <controls:SettingsCard.ActionContent>
                                <ToggleSwitch Style="{StaticResource SettingsToggleStyle}" IsOn="{Binding Settings.AutoRoute, Mode=TwoWay}" />
                            </controls:SettingsCard.ActionContent>
                        </controls:SettingsCard>

                        <controls:SettingsCard
                            Header="Strict route"
                            Description="Enforce routing for all traffic and block leaks."
                            Glyph="&#xE72E;">
                            <controls:SettingsCard.ActionContent>
                                <ToggleSwitch Style="{StaticResource SettingsToggleStyle}" IsOn="{Binding Settings.StrictRoute, Mode=TwoWay}" />
                            </controls:SettingsCard.ActionContent>
                        </controls:SettingsCard>

                        <controls:SettingsCard
                            Header="IPv6"
                            Description="Assign an IPv6 address to the TUN interface."
                            Glyph="&#xE968;">
                            <controls:SettingsCard.ActionContent>
                                <ToggleSwitch Style="{StaticResource SettingsToggleStyle}" IsOn="{Binding Settings.EnableIpv6, Mode=TwoWay}" />
                            </controls:SettingsCard.ActionContent>
                        </controls:SettingsCard>

                        <controls:SettingsCard
                            Header="MTU"
                            Description="Maximum transmission unit of the TUN interface."
                            Glyph="&#xE9D2;">
                            <controls:SettingsCard.ActionContent>
                                <NumberBox
                                    Width="130"
                                    Minimum="1280"
                                    Maximum="65535"
                                    SmallChange="100"
                                    SpinButtonPlacementMode="Hidden"
                                    Value="{Binding Settings.Mtu, Mode=TwoWay}" />
                            </controls:SettingsCard.ActionContent>
                        </controls:SettingsCard>

                        <controls:SettingsCard
                            Header="Mixed port"
                            Description="Local SOCKS and HTTP proxy port."
                            Glyph="&#xE8A7;">
                            <controls:SettingsCard.ActionContent>
                                <NumberBox
                                    Width="130"
                                    Minimum="1"
                                    Maximum="65535"
                                    SpinButtonPlacementMode="Hidden"
                                    Value="{Binding Settings.MixedPort, Mode=TwoWay}" />
                            </controls:SettingsCard.ActionContent>
                        </controls:SettingsCard>

                        <controls:SettingsCard
                            Header="Allow LAN"
                            Description="Let other devices on the network use the proxy port."
                            Glyph="&#xE774;">
                            <controls:SettingsCard.ActionContent>
                                <ToggleSwitch Style="{StaticResource SettingsToggleStyle}" IsOn="{Binding Settings.AllowLan, Mode=TwoWay}" />
                            </controls:SettingsCard.ActionContent>
                        </controls:SettingsCard>

                        <controls:SettingsCard
                            Header="System proxy"
                            Description="Point the Windows proxy settings at the mixed port."
                            Glyph="&#xE713;">
                            <controls:SettingsCard.ActionContent>
                                <ToggleSwitch Style="{StaticResource SettingsToggleStyle}" IsOn="{Binding Settings.SystemProxy, Mode=TwoWay}" />
                            </controls:SettingsCard.ActionContent>
                        </controls:SettingsCard>

                        <controls:SettingsCard
                            Header="Sniffing"
                            Description="Detect protocols and domains from the traffic stream."
                            Glyph="&#xE721;">
                            <controls:SettingsCard.ActionContent>
                                <ToggleSwitch Style="{StaticResource SettingsToggleStyle}" IsOn="{Binding Settings.Sniffing, Mode=TwoWay}" />
                            </controls:SettingsCard.ActionContent>
                        </controls:SettingsCard>

                        <controls:SettingsCard
                            Header="Multiplex"
                            Description="Reuse a single connection for multiple streams."
                            Glyph="&#xE8F4;">
                            <controls:SettingsCard.ActionContent>
                                <ToggleSwitch Style="{StaticResource SettingsToggleStyle}" IsOn="{Binding Settings.Multiplex, Mode=TwoWay}" />
                            </controls:SettingsCard.ActionContent>
                        </controls:SettingsCard>

                        <TextBlock Text="DNS" Style="{StaticResource SectionTitleStyle}" Margin="2,18,0,8" />

                        <controls:SettingsCard
                            Header="DNS mode"
                            Description="How domain names are resolved inside the tunnel."
                            Glyph="&#xE9D9;">
                            <controls:SettingsCard.ActionContent>
                                <ComboBox
                                    Width="150"
                                    ItemsSource="{Binding DnsModeOptions}"
                                    SelectedItem="{Binding Settings.DnsMode, Mode=TwoWay}" />
                            </controls:SettingsCard.ActionContent>
                        </controls:SettingsCard>

                        <controls:SettingsCard
                            Header="DNS server"
                            Description="Used when the DNS mode is set to Custom."
                            Glyph="&#xE968;">
                            <controls:SettingsCard.ActionContent>
                                <TextBox
                                    Width="200"
                                    IsEnabled="{Binding Settings.IsCustomDns}"
                                    Text="{Binding Settings.DnsServer, Mode=TwoWay}" />
                            </controls:SettingsCard.ActionContent>
                        </controls:SettingsCard>

                        <controls:SettingsCard
                            Header="Fallback DNS"
                            Description="Resolver used for local or direct traffic."
                            Glyph="&#xE753;">
                            <controls:SettingsCard.ActionContent>
                                <TextBox
                                    Width="200"
                                    IsEnabled="{Binding Settings.IsCustomDns}"
                                    Text="{Binding Settings.DnsFallback, Mode=TwoWay}" />
                            </controls:SettingsCard.ActionContent>
                        </controls:SettingsCard>
                    </StackPanel>

                    <!-- ============ Core & logs ============ -->
                    <StackPanel x:Name="CoreSection" Visibility="Collapsed">
                        <TextBlock Text="Core" Style="{StaticResource SectionTitleStyle}" Margin="2,0,0,8" />

                        <controls:SettingsCard
                            Header="Log level"
                            Description="Verbosity of the sing-box log."
                            Glyph="&#xE9F9;">
                            <controls:SettingsCard.ActionContent>
                                <ComboBox
                                    Width="150"
                                    ItemsSource="{Binding LogLevelOptions}"
                                    SelectedItem="{Binding Settings.LogLevel, Mode=TwoWay}" />
                            </controls:SettingsCard.ActionContent>
                        </controls:SettingsCard>

                        <controls:SettingsCard
                            Header="Core path"
                            Description="Location of the sing-box executable. Leave empty to detect it from PATH."
                            Glyph="&#xE756;">
                            <controls:SettingsCard.ActionContent>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBox Width="240" Text="{Binding Settings.CorePath, Mode=TwoWay}" />
                                    <Button Content="Browse" Click="OnBrowseCore" />
                                </StackPanel>
                            </controls:SettingsCard.ActionContent>
                        </controls:SettingsCard>

                        <controls:SettingsCard
                            Header="Core status"
                            Description="{Binding CoreStatusText}"
                            Glyph="&#xE9D9;">
                            <controls:SettingsCard.ActionContent>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="Test" Click="OnTestCore" />
                                    <Button Content="Download latest" Click="OnDownloadCore" />
                                </StackPanel>
                            </controls:SettingsCard.ActionContent>
                        </controls:SettingsCard>

                        <controls:SettingsCard
                            Header="Clash API"
                            Description="{Binding ClashController}"
                            Glyph="&#xE968;">
                            <controls:SettingsCard.ActionContent>
                                <TextBlock Text="{Binding CoreVersionText}" Style="{StaticResource CaptionStyle}" VerticalAlignment="Center" />
                            </controls:SettingsCard.ActionContent>
                        </controls:SettingsCard>

                        <controls:SettingsCard
                            Header="Configuration folder"
                            Description="{Binding ConfigPath}"
                            Glyph="&#xE8B7;">
                            <controls:SettingsCard.ActionContent>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="Open folder" Click="OnOpenConfigFolder" />
                                    <Button Content="Reveal" Click="OnRevealConfig" />
                                </StackPanel>
                            </controls:SettingsCard.ActionContent>
                        </controls:SettingsCard>

                        <controls:SettingsCard
                            Header="Config preview"
                            Description="Generate the JSON that will be passed to the core."
                            Glyph="&#xE943;">
                            <controls:SettingsCard.ActionContent>
                                <Button Content="Preview" Click="OnPreviewConfig" />
                            </controls:SettingsCard.ActionContent>
                        </controls:SettingsCard>

                        <TextBlock Text="Logs" Style="{StaticResource SectionTitleStyle}" Margin="2,18,0,8" />

                        <controls:SettingsCard
                            Header="Log file"
                            Description="Open the core log in your default editor."
                            Glyph="&#xE70F;">
                            <controls:SettingsCard.ActionContent>
                                <Button Content="Open log file" Click="OnOpenLogFile" />
                            </controls:SettingsCard.ActionContent>
                        </controls:SettingsCard>

                        <controls:SettingsCard
                            Header="Clear log buffer"
                            Description="Remove all entries currently shown in the Logs page."
                            Glyph="&#xE74D;">
                            <controls:SettingsCard.ActionContent>
                                <Button Content="Clear" Click="OnClearLogs" />
                            </controls:SettingsCard.ActionContent>
                        </controls:SettingsCard>

                        <TextBlock Text="Reset" Style="{StaticResource SectionTitleStyle}" Margin="2,18,0,8" />

                        <controls:SettingsCard
                            Header="Reset all settings"
                            Description="Restore every preference on this page to its default value."
                            Glyph="&#xE777;">
                            <controls:SettingsCard.ActionContent>
                                <Button Content="Reset" Click="OnResetSettings" />
                            </controls:SettingsCard.ActionContent>
                        </controls:SettingsCard>
                    </StackPanel>

                    <!-- ============ About ============ -->
                    <StackPanel x:Name="AboutSection" Visibility="Collapsed">
                        <TextBlock Text="About Tunly" Style="{StaticResource SectionTitleStyle}" Margin="2,0,0,8" />

                        <Border Style="{StaticResource CardBorderStyle}" Padding="18" Margin="0,0,0,4">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Tunly" FontSize="20" FontWeight="SemiBold" />
                                <TextBlock Text="A clean Windows client for sing-box based tunnels." Style="{StaticResource CaptionStyle}" />
                                <TextBlock Text="{Binding VersionText}" Style="{StaticResource CaptionStyle}" />
                                <TextBlock Text="{Binding RuntimeText}" Style="{StaticResource CaptionStyle}" />
                                <TextBlock Text="{Binding OsText}" Style="{StaticResource CaptionStyle}" />
                            </StackPanel>
                        </Border>

                        <controls:SettingsCard
                            Header="Diagnostics"
                            Description="Copy version, runtime and OS details to the clipboard."
                            Glyph="&#xE8C8;">
                            <controls:SettingsCard.ActionContent>
                                <Button Content="Copy" Click="OnCopyDiagnostics" />
                            </controls:SettingsCard.ActionContent>
                        </controls:SettingsCard>

                        <controls:SettingsCard
                            Header="Updates"
                            Description="Check whether a newer build of Tunly is available."
                            Glyph="&#xE895;">
                            <controls:SettingsCard.ActionContent>
                                <Button Content="Check now" Click="OnCheckUpdates" />
                            </controls:SettingsCard.ActionContent>
                        </controls:SettingsCard>

                        <controls:SettingsCard
                            Header="Settings file"
                            Description="Preferences are stored as JSON on this device."
                            Glyph="&#xE8A5;">
                            <controls:SettingsCard.ActionContent>
                                <Button Content="Reveal" Click="OnRevealSettings" />
                            </controls:SettingsCard.ActionContent>
                        </controls:SettingsCard>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>

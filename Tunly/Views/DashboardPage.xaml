<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Tunly.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Tunly.Controls"
    Background="Transparent">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid
            MaxWidth="1160"
            HorizontalAlignment="Center"
            Padding="28,22,28,40"
            RowSpacing="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Spacing="2">
                <TextBlock Text="Dashboard" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="Connection status, live traffic and quick actions." Style="{StaticResource PageSubtitleStyle}" />
            </StackPanel>

            <!-- Elevation notice -->
            <InfoBar
                Grid.Row="1"
                Margin="0,4,0,0"
                Severity="Warning"
                IsClosable="False"
                IsOpen="{Binding Connection.RequiresElevation}"
                Title="Administrator rights required"
                Message="TUN mode needs elevation to create the virtual network adapter.">
                <InfoBar.ActionButton>
                    <Button Content="Restart as administrator" Click="OnRestartAdmin" />
                </InfoBar.ActionButton>
            </InfoBar>

            <!-- Connection error -->
            <InfoBar
                Grid.Row="2"
                Severity="Error"
                Title="Connection failed"
                Message="{Binding Connection.ErrorMessage}"
                IsOpen="{Binding Connection.HasError}"
                CloseButtonClick="OnDismissError" />

            <!-- Connection hero -->
            <Border Grid.Row="3" Style="{StaticResource CardBorderStyle}" Padding="24">
                <Grid RowSpacing="18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid ColumnSpacing="24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Button
                            x:Name="ConnectButton"
                            Width="118"
                            Height="118"
                            Padding="0"
                            CornerRadius="59"
                            Style="{StaticResource AccentButtonStyle}"
                            IsEnabled="{Binding Connection.CanToggle}"
                            Click="OnConnectClick"
                            ToolTipService.ToolTip="Connect or disconnect the tunnel">
                            <Grid>
                                <FontIcon
                                    Glyph="{Binding Connection.ConnectGlyph}"
                                    FontSize="42"
                                    Visibility="{Binding Connection.IconVisibility}" />
                                <ProgressRing
                                    Width="42"
                                    Height="42"
                                    IsActive="{Binding Connection.IsConnecting}"
                                    Visibility="{Binding Connection.RingVisibility}" />
                            </Grid>
                        </Button>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                            <TextBlock
                                Text="{Binding Connection.StateText}"
                                FontSize="26"
                                FontWeight="SemiBold"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Connection.StatusDetail}" Style="{StaticResource CaptionStyle}" />
                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                                <Border Style="{StaticResource BadgeBorderStyle}">
                                    <TextBlock Text="{Binding Connection.ActiveProfileName}" Style="{StaticResource BadgeTextStyle}" />
                                </Border>
                                <Border Style="{StaticResource BadgeBorderStyle}">
                                    <TextBlock Text="{Binding Connection.ActiveProfileDetail}" Style="{StaticResource BadgeTextStyle}" TextTrimming="CharacterEllipsis" MaxWidth="360" />
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ComboBox
                            Header="Active profile"
                            ItemsSource="{Binding Profiles}"
                            SelectedItem="{Binding SelectedProfile, Mode=TwoWay}"
                            DisplayMemberPath="Name"
                            HorizontalAlignment="Stretch"
                            MaxWidth="420" />

                        <Button Grid.Column="1" Content="Manage profiles" VerticalAlignment="Bottom" Click="OnManageProfiles" />
                    </Grid>
                </Grid>
            </Border>

            <!-- Live traffic -->
            <controls:WrapGrid Grid.Row="4" MinItemWidth="190" ItemSpacing="12">
                <Border Style="{StaticResource CardBorderStyle}" Padding="16">
                    <StackPanel Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE896;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="Download" Style="{StaticResource CaptionStyle}" />
                        </StackPanel>
                        <TextBlock Text="{Binding Connection.DownloadText}" Style="{StaticResource StatValueStyle}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorderStyle}" Padding="16">
                    <StackPanel Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE898;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="Upload" Style="{StaticResource CaptionStyle}" />
                        </StackPanel>
                        <TextBlock Text="{Binding Connection.UploadText}" Style="{StaticResource StatValueStyle}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorderStyle}" Padding="16">
                    <StackPanel Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE916;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="Uptime" Style="{StaticResource CaptionStyle}" />
                        </StackPanel>
                        <TextBlock Text="{Binding Connection.UptimeText}" Style="{StaticResource StatValueStyle}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorderStyle}" Padding="16">
                    <StackPanel Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE9D2;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="Session data" Style="{StaticResource CaptionStyle}" />
                        </StackPanel>
                        <TextBlock Text="{Binding Connection.TotalText}" Style="{StaticResource StatValueStyle}" />
                    </StackPanel>
                </Border>
            </controls:WrapGrid>

            <!-- Quick actions + configuration -->
            <controls:WrapGrid Grid.Row="5" MinItemWidth="340" ItemSpacing="16">

                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Quick actions" Style="{StaticResource CardTitleStyle}" />
                        <Grid ColumnSpacing="8" RowSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Button HorizontalAlignment="Stretch" Click="OnTestLatency">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE9D9;" FontSize="14" />
                                    <TextBlock Text="Test latency" />
                                </StackPanel>
                            </Button>

                            <Button Grid.Column="1" HorizontalAlignment="Stretch" Click="OnImportLink">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE71B;" FontSize="14" />
                                    <TextBlock Text="Import link" />
                                </StackPanel>
                            </Button>

                            <Button Grid.Row="1" HorizontalAlignment="Stretch" Click="OnOpenLogs">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE7C3;" FontSize="14" />
                                    <TextBlock Text="View logs" />
                                </StackPanel>
                            </Button>

                            <Button Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch" Click="OnOpenSettings">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE713;" FontSize="14" />
                                    <TextBlock Text="Settings" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Configuration" Style="{StaticResource CardTitleStyle}" />
                            <Button Grid.Column="1" Content="Preview config" Click="OnPreviewConfig" />
                        </Grid>

                        <StackPanel Spacing="6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="TUN stack" Style="{StaticResource CaptionStyle}" />
                                <TextBlock Grid.Column="1" Text="{Binding Settings.TunStack}" FontSize="12" />
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="DNS mode" Style="{StaticResource CaptionStyle}" />
                                <TextBlock Grid.Column="1" Text="{Binding Settings.DnsMode}" FontSize="12" />
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="MTU" Style="{StaticResource CaptionStyle}" />
                                <TextBlock Grid.Column="1" Text="{Binding Settings.Mtu}" FontSize="12" />
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Mixed port" Style="{StaticResource CaptionStyle}" />
                                <TextBlock Grid.Column="1" Text="{Binding Settings.MixedPort}" FontSize="12" />
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </controls:WrapGrid>

            <!-- Recent activity -->
            <Border Grid.Row="6" Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Recent activity" Style="{StaticResource CardTitleStyle}" />
                        <HyperlinkButton Grid.Column="1" Content="View all" Padding="0" Click="OnOpenLogs" />
                    </Grid>

                    <ItemsControl ItemsSource="{Binding RecentLogs}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnSpacing="12" Padding="0,3" ToolTipService.ToolTip="{Binding Message}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60" />
                                        <ColumnDefinition Width="56" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding TimeText}" Style="{StaticResource CaptionStyle}" FontSize="11" />
                                    <TextBlock Grid.Column="1" Text="{Binding LevelText}" FontSize="11" FontWeight="SemiBold" Foreground="{Binding LevelBrush}" />
                                    <TextBlock Grid.Column="2" Text="{Binding Message}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>

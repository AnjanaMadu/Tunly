<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="Tunly.Views.ProfileEditorDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    PrimaryButtonText="Save"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    PrimaryButtonClick="OnSave">

    <ScrollViewer MaxHeight="560" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="12" MinWidth="440">
            <InfoBar
                x:Name="ErrorBar"
                Severity="Error"
                IsOpen="False"
                IsClosable="False" />

            <TextBox x:Name="NameBox" Header="Name" PlaceholderText="Frankfurt – Reality" />

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <ComboBox x:Name="ProtocolBox" Header="Protocol" HorizontalAlignment="Stretch">
                    <ComboBoxItem Content="VLESS" />
                    <ComboBoxItem Content="VMess" />
                    <ComboBoxItem Content="Trojan" />
                    <ComboBoxItem Content="Shadowsocks" />
                    <ComboBoxItem Content="Hysteria2" />
                    <ComboBoxItem Content="TUIC" />
                </ComboBox>

                <ComboBox x:Name="TransportBox" Grid.Column="1" Header="Transport" HorizontalAlignment="Stretch">
                    <ComboBoxItem Content="TCP" />
                    <ComboBoxItem Content="WebSocket" />
                    <ComboBoxItem Content="gRPC" />
                    <ComboBoxItem Content="HTTPUpgrade" />
                    <ComboBoxItem Content="QUIC" />
                </ComboBox>
            </Grid>

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="120" />
                </Grid.ColumnDefinitions>

                <TextBox x:Name="AddressBox" Header="Address" PlaceholderText="example.com" />
                <NumberBox
                    x:Name="PortBox"
                    Grid.Column="1"
                    Header="Port"
                    Minimum="1"
                    Maximum="65535"
                    Value="443"
                    SpinButtonPlacementMode="Hidden" />
            </Grid>

            <PasswordBox x:Name="SecretBox" Header="UUID / password" />

            <TextBox x:Name="SniBox" Header="SNI / server name" PlaceholderText="example.com" />

            <ToggleSwitch x:Name="TlsSwitch" Header="TLS" OnContent="Enabled" OffContent="Disabled" IsOn="True" />

            <Expander Header="Protocol options" HorizontalAlignment="Stretch" IsExpanded="False">
                <StackPanel Spacing="10" Margin="0,8,0,0">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="MethodBox" Header="Shadowsocks method" PlaceholderText="aes-256-gcm" />
                        <TextBox x:Name="UuidBox" Grid.Column="1" Header="UUID (TUIC)" PlaceholderText="uuid" />
                    </Grid>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="FlowBox" Header="VLESS flow" PlaceholderText="xtls-rprx-vision" />
                        <TextBox x:Name="PathBox" Grid.Column="1" Header="Transport path" Text="/" />
                    </Grid>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TransportHostBox" Header="Transport host" PlaceholderText="cdn.example.com" />
                        <TextBox x:Name="ServiceNameBox" Grid.Column="1" Header="gRPC service" PlaceholderText="grpc" />
                    </Grid>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="AlpnBox" Header="ALPN" PlaceholderText="h2,http/1.1" />
                        <TextBox x:Name="FingerprintBox" Grid.Column="1" Header="uTLS fingerprint" PlaceholderText="chrome" />
                    </Grid>

                    <ToggleSwitch x:Name="InsecureSwitch" Header="Allow insecure TLS" OnContent="On" OffContent="Off" />

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="RealityKeyBox" Header="Reality public key" PlaceholderText="pbk" />
                        <TextBox x:Name="RealitySidBox" Grid.Column="1" Header="Reality short id" PlaceholderText="sid" />
                    </Grid>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="ObfsTypeBox" Header="Obfs type" PlaceholderText="salamander" />
                        <TextBox x:Name="ObfsPasswordBox" Grid.Column="1" Header="Obfs password" />
                    </Grid>
                </StackPanel>
            </Expander>

            <Expander Header="Import from share link" HorizontalAlignment="Stretch">
                <StackPanel Spacing="8" Margin="0,8,0,0">
                    <TextBox x:Name="LinkBox" PlaceholderText="vless://… or trojan://…" />
                    <Button Content="Fill fields from link" Click="OnParseLink" />
                </StackPanel>
            </Expander>

            <ToggleSwitch
                x:Name="AdvancedSwitch"
                Header="Advanced"
                OnContent="Raw JSON"
                OffContent="Form"
                Toggled="OnAdvancedToggled" />

            <TextBox
                x:Name="RawBox"
                Height="220"
                AcceptsReturn="True"
                TextWrapping="NoWrap"
                FontFamily="Consolas"
                FontSize="12"
                IsSpellCheckEnabled="False"
                Visibility="Collapsed" />
        </StackPanel>
    </ScrollViewer>
</ContentDialog>

<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Tunly.Views.ProfilesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <Grid Padding="28,22,28,28" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Spacing="2">
                <TextBlock Text="Profiles" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="Select the profile used for the tunnel, or add a new one." Style="{StaticResource PageSubtitleStyle}" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Click="OnImportLink">
                    <Button.Content>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE71B;" FontSize="14" />
                            <TextBlock Text="Import link" />
                        </StackPanel>
                    </Button.Content>
                </Button>
                <Button Style="{StaticResource AccentButtonStyle}" Click="OnAddProfile">
                    <Button.Content>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE710;" FontSize="14" />
                            <TextBlock Text="Add profile" />
                        </StackPanel>
                    </Button.Content>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Toolbar -->
        <Grid Grid.Row="1" ColumnSpacing="10" Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <AutoSuggestBox
                x:Name="SearchBox"
                Width="280"
                QueryIcon="Find"
                PlaceholderText="Search profiles"
                TextChanged="OnSearchChanged" />

            <ComboBox
                x:Name="SortBox"
                Grid.Column="1"
                Width="150"
                Header=""
                SelectedIndex="0"
                SelectionChanged="OnSortChanged">
                <ComboBoxItem Content="Name" />
                <ComboBoxItem Content="Latency" />
                <ComboBoxItem Content="Protocol" />
            </ComboBox>

            <Button Grid.Column="3" Click="OnTestAll">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE9D9;" FontSize="14" />
                    <TextBlock Text="Test latency" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- List -->
        <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Padding="6" Margin="0,4,0,0">
            <Grid>
                <ListView
                    x:Name="ProfileList"
                    ItemsSource="{Binding Visible}"
                    SelectionMode="Single"
                    ItemContainerStyle="{StaticResource CompactListItemStyle}"
                    Visibility="{Binding ListVisibility}"
                    SelectionChanged="OnSelectionChanged"
                    DoubleTapped="OnListDoubleTapped">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="8,8" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3" />
                                    <ColumnDefinition Width="32" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="84" />
                                    <ColumnDefinition Width="36" />
                                </Grid.ColumnDefinitions>

                                <Border
                                    Width="3"
                                    Height="26"
                                    CornerRadius="2"
                                    VerticalAlignment="Center"
                                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                                    Visibility="{Binding ActiveMarkVisibility}" />

                                <Border
                                    Grid.Column="1"
                                    Width="30"
                                    Height="30"
                                    CornerRadius="15"
                                    VerticalAlignment="Center"
                                    Background="{ThemeResource ControlFillColorSecondaryBrush}">
                                    <TextBlock
                                        Text="{Binding Initial}"
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center" />
                                </Border>

                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="1">
                                    <TextBlock
                                        Text="{Binding Name}"
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Text="{Binding Endpoint}"
                                        FontSize="11"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>

                                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <Border Style="{StaticResource BadgeBorderStyle}">
                                        <TextBlock Text="{Binding Protocol}" Style="{StaticResource BadgeTextStyle}" />
                                    </Border>
                                    <Border Style="{StaticResource BadgeBorderStyle}">
                                        <TextBlock Text="{Binding TransportText}" Style="{StaticResource BadgeTextStyle}" />
                                    </Border>
                                </StackPanel>

                                <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" HorizontalAlignment="Right">
                                    <Ellipse Width="7" Height="7" Fill="{Binding LatencyBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding LatencyText}" FontSize="12" />
                                </StackPanel>

                                <Button
                                    Grid.Column="5"
                                    Padding="0"
                                    Width="32"
                                    Height="32"
                                    HorizontalAlignment="Right"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Click="OnRowMenuClick"
                                    ToolTipService.ToolTip="More actions">
                                    <FontIcon Glyph="&#xE712;" FontSize="14" />
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- Empty state -->
                <StackPanel
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="8"
                    MaxWidth="360"
                    Visibility="{Binding EmptyVisibility}">
                    <FontIcon Glyph="&#xE774;" FontSize="36" Opacity="0.5" HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding EmptyTitle}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding EmptyDescription}" Style="{StaticResource CaptionStyle}" TextAlignment="Center" />
                    <Button Content="Add profile" HorizontalAlignment="Center" Style="{StaticResource AccentButtonStyle}" Click="OnAddProfile" Margin="0,8,0,0" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
